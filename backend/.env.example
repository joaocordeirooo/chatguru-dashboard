PORT=3000
NODE_ENV=development
DEMO_MODE=true
APP_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
# Read-only connection to existing ChatGuru database:
DATABASE_URL=
# Separate database for dashboard accounts:
AUTH_DATABASE_URL=
DATABASE_SSL=false
AUTH_DATABASE_SSL=false
OUTGOING_DIRECTION=saida
SENT_STATUSES=enviada
RECEIVED_DIRECTION=entrada
SOURCE_SCHEMA=atendimento
# Para importar CSV, copie a chave HEX de arquivamento do arquivo de acesso privado.
# ARCHIVE_ENCRYPTION_KEY=
# Opcional: credencial com escrita no MESMO banco de DATABASE_URL.
# SOURCE_WRITE_DATABASE_URL=
# Chave OpenAI apenas no backend; não usar variáveis VITE_ para segredos.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

